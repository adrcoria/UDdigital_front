# Credenciales de las pruebas E2E. Copia este archivo como `.env.e2e` y llenalo.
# `.env.e2e` esta en .gitignore: nunca se sube al repo.

# Usuario con el que inician sesion las pruebas
E2E_MAIL=
E2E_PASSWORD=

# Codigo de la empresa de pruebas (el que se captura en el login)
E2E_COMPANY_CODE=ABC

# Nombre de la empresa de pruebas, como aparece en los selectores de la app
E2E_COMPANY_NAME=test

# URL donde corre la app
E2E_BASE_URL=http://localhost:3000

# Origen de la API (debe coincidir con VITE_BASE_URL del .env del proyecto)
E2E_API_URL=https://api.agroindustriaselarteaguense.cloud

# Pon 1 para habilitar las pruebas que NO se pueden deshacer
# (venta de ganado, defuncion, edicion de parametros globales)
E2E_ALLOW_IRREVERSIBLE=0
